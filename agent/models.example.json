{
  "providers": {
    "local-proxy": {
      "api": "openai-completions",
      "apiKey": "$LOCAL_PROXY_API_KEY",
      "baseUrl": "http://127.0.0.1:8317/v1",
      "models": [
        {
          "id": "example-model-id",
          "contextWindow": 128000,
          "maxTokens": 32000,
