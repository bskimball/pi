  "terminal": {
    "showTerminalProgress": false
  },
  "editorPaddingX": 2,
  "theme": "apex-dark",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "local-proxy/*",
    "openai-codex/*",
    "github-copilot/*",
    "xai/*",
    "google/*",
    "ollama/*",
    "cloudflare-workers-ai/**"
  ]
}