{
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "local-proxy",
  "defaultThinkingLevel": "medium",
  "lastChangelogVersion": "0.84.2",
  "packages": [
    "npm:@ff-labs/pi-fff"
  ],
  "skills": [
    "../node_modules/pi-mcp-adapter/skills"
  ],
  "quietStartup": true,
  "compaction": {
    "reserveTokens": 44000,
    "keepRecentTokens": 20000
  },
  "steeringMode": "one-at-a-time",
  "transport": "websocket",
  "terminal": {
    "showTerminalProgress": false
  },
  "editorPaddingX": 2,
  "theme": "apex-dark",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "local-proxy/*",
    "openai-codex/*",
    "github-copilot/*",
    "xai/*",
    "google/*",
    "ollama/*",
    "opencode/*",
    "cloudflare-workers-ai/**"
  ],
  "hideThinkingBlock": false
}