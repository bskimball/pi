{
  "defaultModel": "grok-4.5",
  "defaultProvider": "xai",
  "defaultThinkingLevel": "medium",
  "lastChangelogVersion": "0.83.0",
  "packages": [
    "npm:pi-sticky-input"
  ],
  "quietStartup": true,
  "steeringMode": "one-at-a-time",
  "transport": "websocket",
  "terminal": {
    "showTerminalProgress": false
  },
  "editorPaddingX": 2,
  "theme": "apex-dark",
  "enabledModels": [
    "local-proxy/*",
    "openai-codex/*",
    "github-copilot/*",
    "xai/*",
    "google/*",
    "google-gemini-cli/*",
    "ollama/*"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  }
}