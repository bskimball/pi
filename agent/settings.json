{
  "defaultModel": "claude-opus-5",
  "defaultProvider": "local-proxy",
  "defaultThinkingLevel": "medium",
  "lastChangelogVersion": "0.83.0",
  "packages": [
    "npm:pi-sticky-input"
  ],
  "quietStartup": true,
  "steeringMode": "one-at-a-time",
  "transport": "websocket",
  "terminal": {
    "showTerminalProgress": false
  },
  "editorPaddingX": 2,
  "theme": "apex-dark",
  "enabledModels": [
    "local-proxy/*",
    "openai-codex/*",
    "github-copilot/*",
    "xai/*",
    "google/*",
    "google-gemini-cli/*",
    "ollama/*",
    "cloudflare-workers-ai/*"
  ]
}