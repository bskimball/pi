{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "node"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    ".tmp/**",
    "graphify-out/**",
    "reference/**",
    "**/node_modules/**"
  ],
  "rules": {
    "no-control-regex": "off",
    "no-misleading-character-class": "off",
    "no-unused-vars": "warn",
    "no-useless-escape": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-new-array": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.mjs"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@pi/ui-kit",
                "message": "Tests must import the small defining module, never the ui-kit barrel. Static `from \"@pi/ui-kit\"` and `await import(\"@pi/ui-kit\")` both type-strip the full kit and trip the amaro/SWC crash. Use `@pi/ui-kit/internal/...` or a relative `../internal/...` path instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
