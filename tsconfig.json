{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "pi-mcp-adapter": ["./agent/types/pi-mcp-adapter.d.ts"]
    }
  },
  "include": [
    "agent/extensions/**/*.ts",
    "agent/types/**/*.d.ts"
  ]
}
