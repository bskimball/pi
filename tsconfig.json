{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "pi-mcp-adapter": ["./agent/types/pi-mcp-adapter.d.ts"],
      "@pi/ui-kit": ["./packages/ui-kit/index.ts"],
      "@pi/ui-kit/*": ["./packages/ui-kit/*"]
    }
  },
  "include": [
    "agent/extensions/**/*.ts",
    "agent/types/**/*.d.ts",
    "packages/ui-kit/**/*.ts"
  ]
}
